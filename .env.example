# Copy to .env for local runs. Never commit .env.
DEMO_ACCESS_CODE=
ASSEMBLYAI_API_KEY=
ANTHROPIC_API_KEY=
# optional
# OPENFDA_API_KEY=
# ASSEMBLYAI_REGION=global
# NOTE_MODEL=claude-sonnet-5-5
# FAST_MODEL=claude-haiku-5-5
# NOTE_EFFORT=medium

# This checkout supports synthetic demonstrations only.
MEDSCRIBE_MODE=demo
MEDSCRIBE_DATA_CLASSIFICATION=synthetic
MEDSCRIBE_ALLOW_ROLE_SWITCH=0
# Separate credentials for each role; empty disables that role's login.
DEMO_DOCTOR_CODE=
DEMO_NETWORK_CODE=
DEMO_SPONSOR_CODE=
DEMO_PHARMACY_CODE=
